# =============================================================================
# OCI Instance Creation — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `oci.env` and fill in your values:
#     cp oci.env.sample oci.env
#
# Alternatively, run `./setup_env.sh` to generate it interactively.
# =============================================================================

# --- OCI Configuration (Required) --------------------------------------------
# Absolute path to your OCI API config file (see sample_oci_config)
OCI_CONFIG=/home/ubuntu/oracle-free-tier-instance-creation/oci_config

# Availability domain(s) eligible for the Always-Free tier.
# Separate multiple domains with commas (the script rotates through them).
# Example: AwhC:AP-HYDERABAD-1-AD-1
OCT_FREE_AD=AD-1

# Display name shown in the OCI console for the instance
DISPLAY_NAME=my-arm-ubuntu-instance

# Compute shape: VM.Standard.A1.Flex (ARM) or VM.Standard.E2.1.Micro (AMD)
OCI_COMPUTE_SHAPE=VM.Standard.A1.Flex

# Set to True ONLY when creating your second Always-Free Micro instance
SECOND_MICRO_INSTANCE=False

# Seconds to wait between retry attempts
REQUEST_WAIT_TIME_SECS=60

# Absolute path to your SSH public key for the ARM instance.
# A key pair is auto-generated at this path if it doesn't exist.
SSH_AUTHORIZED_KEYS_FILE=/home/ubuntu/oracle-free-tier-instance-creation/id_rsa.pub

# --- Networking & Image (Optional) -------------------------------------------
# Subnet OCID — REQUIRED when running locally (not on a Micro instance).
# Leave empty when running on a Micro instance (auto-detected).
OCI_SUBNET_ID=

# Specific image OCID. If empty, OPERATING_SYSTEM + OS_VERSION are used.
OCI_IMAGE_ID=

# Used to auto-discover the latest image when OCI_IMAGE_ID is empty
OPERATING_SYSTEM="Canonical Ubuntu"
OS_VERSION=22.04

# Assign an ephemeral public IP to the instance (true/false)
ASSIGN_PUBLIC_IP=false

# Boot volume size in GB (values below 50 are ignored and default to 50)
BOOT_VOLUME_SIZE=50

# --- Gmail Notification (Optional) -------------------------------------------
NOTIFY_EMAIL=False
EMAIL=your.email@gmail.com
EMAIL_PASSWORD=your16charapppassword

# --- Discord Notification (Optional) -----------------------------------------
DISCORD_WEBHOOK=

# --- Telegram Notification (Optional) ----------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=
